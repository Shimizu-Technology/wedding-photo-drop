FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Production Active Storage S3 (public-read bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=wedding-photo-drop-uploads-prod
# Optional CDN/custom host. If unset, public URLs use the S3 virtual-hosted URL.
AWS_PUBLIC_HOST=

# Production/API hosting
APP_HOST=
DATABASE_URL=
UPLOAD_RATE_LIMIT_PER_MINUTE=12
EVENT_UPLOAD_RATE_LIMIT_PER_MINUTE=60
