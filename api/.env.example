# Local frontend origins allowed to call the Rails API.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional Clerk auth. If omitted in development, the admin API uses a local dev admin fallback.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_SECRET_KEY=
CLERK_ALLOW_DEV_AUTH=true
DEV_AUTH_EMAIL=admin@example.test

# Optional seed bootstrap. Set SUPER_ADMIN_EMAIL in production before running db:seed
# to create or repair the primary admin account from environment variables.
SUPER_ADMIN_EMAIL=
SEED_EVENT_NAME=Leon & Kami's Wedding
SEED_EVENT_SLUG=leon-wedding
SEED_UPLOAD_TOKEN=
SEED_ADMIN_TOKEN=

# Optional invite emails for admin-created users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional for local S3 smoke tests. Development uploads use local disk storage by default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=
